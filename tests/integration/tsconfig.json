{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["harness/**/*.ts", "scenarios/**/*.ts", "deploy/**/*.ts", "e2e/**/*.ts", "vitest.config.ts", "vitest.deploy.config.ts"]
}
