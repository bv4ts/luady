{
  "session_id": "SESSION_ID",
  "transcript_path": "<transcript>",
  "cwd": "<cwd>",
  "scratchpad_dir": "<scratchpad>",
  "prompt_id": "PROMPT_ID",
  "permission_mode": "default",
  "effort": {
    "level": "medium"
  },
  "hook_event_name": "PermissionRequest",
  "tool_name": "Bash",
  "tool_input": {
    "command": "touch a.txt",
    "description": "<text>"
  },
  "permission_suggestions": [
    {
      "type": "addDirectories",
      "directories": [
        "<cwd>"
      ],
      "destination": "session"
    },
    {
      "type": "setMode",
      "mode": "acceptEdits",
      "destination": "session"
    }
  ]
}
