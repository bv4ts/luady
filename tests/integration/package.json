{
  "name": "luady-integration-tests",
  "private": true,
  "type": "module",
  "description": "Luady integration (Docker fake fleet) and web e2e tests; a standalone folder, not an npm workspace.",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "test:deploy": "vitest run --config vitest.deploy.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
