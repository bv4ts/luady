#!/usr/bin/env python3
"""luady-ctl shim: runs luady_kit.ctl from ~/.luady/lib, the lib dir next to this bin dir."""
import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
for _candidate in (_ROOT, os.path.join(_ROOT, 'lib')):
    if os.path.isdir(os.path.join(_candidate, 'luady_kit')):
        sys.path.insert(0, _candidate)

from luady_kit.ctl import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
