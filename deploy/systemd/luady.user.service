# Luady hub as a systemd user service: it runs as you, from your clone, on http://localhost:7410.
#   cp deploy/systemd/luady.user.service ~/.config/systemd/user/luady.service
#   systemctl --user daemon-reload && systemctl --user enable --now luady.service
#   loginctl enable-linger "$USER"     # optional: keep it running while you are logged out
# The paths assume the clone is ~/luady and Node 22 is on the PATH below; edit them if yours differ. The output goes to
# the journal (journalctl --user -u luady.service), so the hub prints no setup code there: run
# npm run luady -- setup-code in a terminal for one.
[Unit]
Description=Luady hub
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/luady
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node packages/hub/dist/cli.js start
Restart=on-failure
RestartSec=5
# A restart stops only the node process: the tmux servers of your sessions and of the manager keep running, and the
# next hub process finds them again.
KillMode=process
TimeoutStopSec=20
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
