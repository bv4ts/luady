{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@luady/office": ["../office/src/index.ts"],
      "@luady/shared/pure": ["../shared/src/pure/index.ts"],
      "@luady/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts", "vitest.dist.config.ts"]
}
